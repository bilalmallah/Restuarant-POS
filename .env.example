# ──────────────────────────────────────────────────────────────
#  EASY RESTAURANT — single source of truth for the whole stack.
#  Backend reads this file directly; Vite reads it through envDir,
#  so changing APP_NAME here renames the product EVERYWHERE.
# ──────────────────────────────────────────────────────────────

# ---------- Branding ----------
APP_NAME="Easy Restaurant"
APP_TAGLINE="Restaurant Point of Sale"
APP_CURRENCY="Rs"
APP_PHONE="0300-0000000"
APP_ADDRESS="Main Road, Karachi"
APP_FOOTER_NOTE="Thank you for dining with us!"

# ---------- Server ----------
PORT="5000"
NODE_ENV="development"
FRONTEND_ORIGIN="http://localhost:5173"

# ---------- Database ----------
DATABASE_NAME="easy_restaurant"
DATABASE_USER="postgres"
DATABASE_PASSWORD=""
DATABASE_HOST="localhost"
DATABASE_PORT=5432

# ---------- Auth ----------
AUTH_JWT_SECRET_KEY=""
AUTH_JWT_EXPIRES_IN="30d"

# ---------- Backups ----------
# A weekly pg_dump of the database, kept next to the project in backups/.
# Leave PG_DUMP_PATH blank and it finds Postgres on its own; set it if you have
# an unusual install. BACKUP_DIR is best pointed at a synced or external drive -
# a backup on the same disk does not survive that disk dying.
ENABLE_BACKUPS="true"
BACKUP_INTERVAL_DAYS=7
BACKUP_KEEP=8
BACKUP_DIR=""
PG_DUMP_PATH=""

# ---------- Defaults ----------
DEFAULT_ADMIN_EMAIL="admin@easyrestaurant.com"
DEFAULT_ADMIN_PASSWORD="admin123"
